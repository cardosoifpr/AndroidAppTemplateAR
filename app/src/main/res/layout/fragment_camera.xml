<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101522">

    <FrameLayout
        android:id="@+id/sceneContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/battlePanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_margin="12dp"
        android:background="#E91B2435"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Preparando batalha..."
            android:textColor="#DCE6F5"
            android:textSize="12sp"
            android:gravity="center"
            android:paddingBottom="10dp" />

        <TextView
            android:id="@+id/healthPlayer1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PERSONAGEM 1  •  100 HP"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="14sp" />

        <ProgressBar
            android:id="@+id/barPlayer1"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="12dp"
            android:max="100"
            android:progress="100"
            android:progressTint="#45D483"
            android:progressBackgroundTint="#465466" />

        <TextView
            android:id="@+id/healthPlayer2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PERSONAGEM 2  •  100 HP"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="14sp" />

        <ProgressBar
            android:id="@+id/barPlayer2"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:layout_marginTop="5dp"
            android:max="100"
            android:progress="100"
            android:progressTint="#E96A75"
            android:progressBackgroundTint="#465466" />
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/place"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Centralizar"
        android:layout_margin="16dp"
        app:icon="@android:drawable/ic_menu_view"
        app:layout_constraintBottom_toTopOf="@id/actionPanel"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/actionPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="16dp"
        android:layout_margin="12dp"
        android:background="#E91B2435"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/turnText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Aguardando batalha"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="17sp"
            android:gravity="center"
            android:paddingBottom="10dp" />

        <Button
            android:id="@+id/attackButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="ATACAR"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#C74755" />

        <Button
            android:id="@+id/restartButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="JOGAR NOVAMENTE"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/gameOverPanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="28dp"
        android:background="#F2101522"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FIM DE BATALHA"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/winnerText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="#F5D98A"
            android:textSize="19sp"
            android:padding="20dp" />

        <Button
            android:id="@+id/restartGameButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="JOGAR NOVAMENTE" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
